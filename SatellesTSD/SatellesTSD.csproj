<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SatellesTSD.Core\SatellesTSD.Core.csproj" />
    <ProjectReference Include="..\SatellesTSD.Infrastructure\SatellesTSD.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MTA's schema set, so the window validates the file it writes exactly as the tests do -->
    <None Include="..\schemas\apa-tsd\**" Link="schemas\apa-tsd\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the release version: shown in the window title, named in the release folder by tools\Publish-Release.ps1 -->
    <Version>0.19.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SatellesTSD.WindowTests" />
  </ItemGroup>

</Project>